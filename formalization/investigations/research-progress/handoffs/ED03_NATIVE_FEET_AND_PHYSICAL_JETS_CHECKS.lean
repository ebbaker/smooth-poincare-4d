open SmoothPoincare
open MeasureTheory Set
open scoped Interval

/-- A finite quarter-exponent flux has the explicit time factor √(2τ). -/
example {τ K L e₀ eτ : ℝ} (hτ : 0 < τ) (hK : 0 ≤ K) (hL : 0 ≤ L)
    (a : ℝ → ℝ) (ha : MemLp a 2 (volume.restrict (Ioc 0 τ)))
    (hn : 0 ≤ᵐ[volume.restrict (Ioc 0 τ)] a)
    (hbudget : (∫ s in (0 : ℝ)..τ, (a s)^2) ≤ L^2)
    (hflux : |eτ-e₀| ≤ K * ∫ s in (0 : ℝ)..τ,
      Real.sqrt (τ^(2*(1/4 : ℝ)) * s^(-(2*(1/4 : ℝ)))) * a s) :
    |eτ-e₀| ≤ (K*L) * Real.sqrt (2*τ) := by
  have h := modifiedEuler_transport_of_flux (b := 1/4) hτ (by norm_num) hK hL a ha hn hbudget hflux
  rw [modifiedEuler_timeWeight hτ (by norm_num), show τ/(1-2*(1/4 : ℝ)) = 2*τ by ring] at h
  exact h

/-- For half interpolation the two frozen endpoint products leave the measured
quarter of the product of endpoint first-jet differences, with negative sign. -/
example (a b c d : ℝ) :
    ((a+b)/2)*((c+d)/2) - (a*c+b*d)/2 = -(b-a)*(d-c)/4 := by
  have h := frozenFirstJet_mul_sub_weighted a b c d (1/2)
  linarith only [h]
